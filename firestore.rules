rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Estadísticas y calendario: los escribe solo la sincronización (con credenciales de servidor).
    match /stats/{id} { allow read: if true; allow write: if false; }
    match /meta/{id}  { allow read: if true; allow write: if false; }
    // Precios únicos para todas las ligas: los actualiza solo el cierre diario de las 20:00.
    match /market/{id} { allow read: if true; allow write: if false; }

    // Lista de ligas de cada usuario: solo el dueño.
    match /users/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }

    match /leagues/{lid} {
      function league() { return get(/databases/$(database)/documents/leagues/$(lid)).data; }
      function isMember() { return signedIn() && request.auth.uid in league().members; }

      // Cualquiera con sesión iniciada puede ver una liga (así funciona el link de invitación).
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // Los miembros juegan (mercado, ventas). Los ajustes solo los cambia el creador.
      // Un no miembro solo puede sumarse a sí mismo.
      allow update: if signedIn()
        && request.resource.data.owner == resource.data.owner
        && (request.resource.data.settings == resource.data.settings || request.auth.uid == resource.data.owner)
        && (
          request.auth.uid in resource.data.members
          || (request.auth.uid in request.resource.data.members
              && request.resource.data.members.size() == resource.data.members.size() + 1
              && request.resource.data.members.hasAll(resource.data.members))
        );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /members/{uid} {
        // El 11 de cada fecha (lineups.fN) solo se puede guardar ANTES de que arranque el primer partido de esa fecha.
        // La hora la pone el servidor (request.time), no el teléfono de cada uno.
        function lineupOk() {
          let keys = request.resource.data.get('lineups', {}).diff(resource.data.get('lineups', {})).affectedKeys();
          let r = request.resource.data.get('lineupRound', 0);
          let rounds = get(/databases/$(database)/documents/meta/calendar).data.get('rounds', {});
          return keys.size() == 0
            || (keys.hasOnly(['f' + string(r)])
                && (!(string(r) in rounds) || request.time.toMillis() < rounds[string(r)]));
        }
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid;
        // Cada uno edita solo lo suyo; los fichajes de las 20:00 los aplica el servidor.
        allow update: if signedIn() && request.auth.uid == uid && isMember()
          && request.resource.data.get('firstRound', 0) == resource.data.get('firstRound', 0)
          && lineupOk();
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /bids/{uid} {
        allow read: if isMember();
        allow write: if signedIn() && request.auth.uid == uid && isMember();
      }
    }
  }
}
